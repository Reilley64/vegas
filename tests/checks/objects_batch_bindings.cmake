# Fails when a function whose call tools/bind-batch bound to the body at the
# recipe's row (VEGAS-125) again refers to the stand-in name it used before,
# which no object defines, or no longer refers to the row owner's name
# (tools/function-relocations/batch-bindings.tsv, generated by
# bind_batch.py apply from the object proof's retargets). Blind spots: those
# of tools/function-relocations; it counts names, not calls, and sees one
# function's own section, not the copies other functions inline.
if(vegas_object_checks)
  add_test(NAME objects.batch_bindings
    COMMAND ${GO_EXECUTABLE} run . --table batch-bindings.tsv
            --objects ${CMAKE_CURRENT_BINARY_DIR}/game-objects.txt
    WORKING_DIRECTORY ${PROJECT_SOURCE_DIR}/tools/function-relocations)
endif()
