set bind-root false
set traversal AsIs
set output diag
let NARROW qualType(isInteger(), unless(hasCanonicalType(anyOf(asString("long long"), asString("unsigned long long")))))
let WIDE qualType(hasCanonicalType(anyOf(asString("long long"), asString("unsigned long long"))))
let INFN optionally(hasAncestor(functionDecl().bind("fn")))
let PTRS expr(anyOf(hasType(pointsTo(pointerType())), hasType(arrayType(hasElementType(pointerType())))))
let THROUGH unaryOperator(hasOperatorName("*"), hasUnaryOperand(ignoringParenCasts(unaryOperator(hasOperatorName("&"), hasUnaryOperand(ignoringParenCasts(PTRS))))))
let PP ignoringParenCasts(expr(anyOf(PTRS, THROUGH)))
let SCALE4 anyOf(binaryOperator(hasOperatorName("*"), hasEitherOperand(ignoringParenImpCasts(integerLiteral(equals(4))))), binaryOperator(hasOperatorName("<<"), hasRHS(ignoringParenImpCasts(integerLiteral(equals(2))))))
let HAS4 anyOf(ignoringParenImpCasts(SCALE4), hasDescendant(expr(SCALE4)))
let VAR4 ignoringParenImpCasts(declRefExpr(to(varDecl(hasInitializer(HAS4)))))
let COUNT4 expr(hasType(isInteger()), anyOf(HAS4, VAR4))
let MEMFN functionDecl(matchesName("[Mm]em([Cc]py|[Cc]opy|[Mm]ove|[Ss]et|[Cc]mp)"), unless(matchesName("wmem")))
let P2I castExpr(hasCastKind("CK_PointerToIntegral"))
let A castExpr(hasCastKind("CK_PointerToIntegral"), hasType(NARROW), hasSourceExpression(expr(hasType(qualType().bind("A_from")))))
let B castExpr(hasCastKind("CK_IntegralCast"), hasType(NARROW), hasSourceExpression(ignoringParenImpCasts(castExpr(hasCastKind("CK_PointerToIntegral"), hasType(WIDE)))))
let C castExpr(hasCastKind("CK_IntegralCast"), hasType(NARROW), hasSourceExpression(ignoringParenImpCasts(declRefExpr(to(varDecl(hasType(WIDE), hasInitializer(ignoringParenImpCasts(P2I))))))))
let D castExpr(hasCastKind("CK_IntegralToPointer"), hasSourceExpression(expr(hasType(NARROW), unless(ignoringParenImpCasts(integerLiteral())))))
let E callExpr(callee(MEMFN), hasAnyArgument(PP))
let F callExpr(callee(MEMFN), hasAnyArgument(COUNT4))
let G explicitCastExpr(hasDestinationType(pointsTo(pointerType())), hasSourceExpression(ignoringParenImpCasts(callExpr(hasType(asString("void *")), hasAnyArgument(anyOf(ignoringParenImpCasts(integerLiteral()), HAS4))))))
m castExpr(A, INFN).bind("A_ptr_to_narrow")
m castExpr(B, INFN).bind("B_ptr_wide_then_narrow")
m castExpr(C, INFN).bind("C_ptr_var_then_narrow")
m castExpr(D, INFN).bind("D_narrow_to_ptr")
m callExpr(E, INFN).bind("E_mem_on_pointer_array")
m callExpr(F, INFN).bind("F_mem_scaled_by_4")
m explicitCastExpr(G, INFN).bind("G_pointer_array_from_byte_count")
m callExpr(hasType(asString("void *")), unless(callee(MEMFN)), hasAnyArgument(anyOf(ignoringParenImpCasts(integerLiteral()), HAS4)), unless(hasParent(explicitCastExpr()))).bind("X_untyped_storage_by_literal_or_times_4")
m binaryOperator(hasOperatorName("="), hasLHS(arraySubscriptExpr(hasType(pointerType()))), hasRHS(ignoringParenImpCasts(arraySubscriptExpr(hasType(pointerType())))), hasAncestor(stmt(anyOf(forStmt(), whileStmt(), doStmt())))).bind("X_pointer_copied_in_a_loop")
m castExpr(hasCastKind("CK_IntegralCast"), hasType(NARROW), hasSourceExpression(ignoringParenImpCasts(declRefExpr(to(varDecl(hasType(WIDE), unless(hasInitializer(ignoringParenImpCasts(P2I))))))))).bind("X_narrowing_of_other_64_bit_variable")
set output dump
m castExpr(A).bind("A_ptr_to_narrow")
m castExpr(B).bind("B_ptr_wide_then_narrow")
m castExpr(C).bind("C_ptr_var_then_narrow")
m castExpr(D).bind("D_narrow_to_ptr")
m callExpr(E).bind("E_mem_on_pointer_array")
m callExpr(F).bind("F_mem_scaled_by_4")
m explicitCastExpr(G).bind("G_pointer_array_from_byte_count")
